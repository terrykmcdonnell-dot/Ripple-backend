# Ripple API — copy to `.env` and fill in values (never commit `.env`).

# API listen port (uvicorn --port; default in docs/deploy is 8001)
# API_PORT=8001

# Supabase (service role for server-side writes / Auth admin)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# RevenueCat webhook — full HTTPS URL to enter in RevenueCat → Integrations → Webhooks
# Must match your deployed API route: POST {origin}/revenuecat
REVENUECAT_WEBHOOK_PUBLIC_URL=https://api.ripplealarm.com/revenuecat

# Optional: same string RevenueCat sends as the Authorization header (recommended)
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Entitlement identifier in RevenueCat (default pro); must match the mobile app env
REVENUECAT_ENTITLEMENT_ID=pro
